[user]
  name = motty93
  email = rdwbocungelt5@gmail.com
[core]
  # SESSION_MANAGER が残っていると vim (+X11) がセッションマネージャ接続を試み、
  # ホスト名変更後のセッションで _IceTransSocketUNIXConnect エラーがコミット画面に出る。
  # -X と違いクリップボード連携は残したいので、この変数だけ落とす
  editor = env -u SESSION_MANAGER vim
  autocrlf = input
  excludesfile = ~/.gitignore_global
#[remote "origin"]
#  fetch = +refs/heads/*:refs/remotes/origin/*
[color]
  diff = auto
  status = auto
  branch = auto
[help]
  autocorrect = 1
[diff]
  noprefix = true
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[submodule]
	recurse = true
